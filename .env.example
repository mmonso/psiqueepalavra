# Endereço público do site. Usado no sitemap, nas tags Open Graph e nos links
# compartilhados. Sem barra no final.
NEXT_PUBLIC_SITE_URL="https://psiqueepalavra.com.br"

# Chave da API do Gemini, usada apenas pelo Diálogo Socrático.
# Fica somente no servidor — nunca use o prefixo NEXT_PUBLIC_ aqui.
# Se estiver ausente, o site continua funcionando e o recurso de IA
# aparece desativado, com aviso ao leitor.
GEMINI_API_KEY=""
